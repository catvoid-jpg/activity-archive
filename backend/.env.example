# 활동기록 아카이브 백엔드 환경변수 예시
# 실제 값은 .env 파일에 두며, .env는 커밋하지 않는다(.gitignore 처리됨).
# 비밀값은 소스코드에 하드코딩하지 않고 이 환경변수를 통해서만 주입한다.

# 서버 포트
PORT=3000

# 외부 LLM API (서버에서만 사용, 클라이언트에 노출 금지)
AI_API_KEY=
AI_API_BASE_URL=

# 비용 통제 상한값 (설계상 임의 고정 금지 → 배포 환경 설정값으로 주입)
# 전역 월간 AI 호출 상한
AI_MONTHLY_CALL_LIMIT=
# 단일 요청에서 AI에 전달하는 입력 길이 상한(문자 수)
AI_INPUT_CHAR_LIMIT=

# 데이터베이스 연결 문자열 (무료 티어 관계형 DB)
DATABASE_URL=
